# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM='"StreamTube" <noreply@streamtube.com>'

# Object storage (MinIO for local development, S3 in production)
# Two endpoints are required and are NOT interchangeable: SigV4 signs the `host`
# header, so a presigned URL handed to a caller outside the Docker network must be
# signed against S3_ENDPOINT_PUBLIC. Server-side operations use S3_ENDPOINT_INTERNAL.
S3_ENDPOINT_INTERNAL=http://minio:9000
S3_ENDPOINT_PUBLIC=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_VIDEOS=streamtube-videos
S3_BUCKET_THUMBNAILS=streamtube-thumbnails
S3_ACCESS_KEY_ID=streamtube
S3_SECRET_ACCESS_KEY=streamtube
S3_FORCE_PATH_STYLE=true
PRESIGN_TTL_SECONDS=900
