# Copie para .env.local e ajuste os valores:
#   cp .env.example .env.local
#
# Fonte da verdade: lib/env.ts (@t3-oss/env-nextjs + Zod). As variáveis abaixo
# são validadas no boot e no build — valor ausente ou inválido derruba a app.
# Não adicione NODE_ENV aqui: o Next.js o define automaticamente.

# ---------------------------------------------------------------------------
# API_URL — base URL da API NestJS (obrigatória, precisa ser uma URL válida)
# ---------------------------------------------------------------------------
# Server-only: lida apenas via `env.API_URL` em código de servidor. Não existe
# variante NEXT_PUBLIC_* para a URL do backend — expor isso quebraria o BFF.
#
# O valor depende da topologia Docker. As duas stacks hoje são separadas
# (nestjs-project e next-frontend têm redes Compose próprias), então o frontend
# alcança o backend pela porta publicada no host, via o `extra_hosts`
# host.docker.internal declarado no compose.yaml:
API_URL=http://host.docker.internal:3000
# Se um dia as stacks compartilharem a mesma rede Compose, troque pelo nome do
# serviço: API_URL=http://nestjs-api:3000

# ---------------------------------------------------------------------------
# SESSION_PASSWORD — chave de criptografia do cookie de sessão (iron-session)
# ---------------------------------------------------------------------------
# Mínimo de 32 caracteres. Gere um valor próprio — NÃO use o placeholder:
#   openssl rand -base64 32
SESSION_PASSWORD=change-me-with-a-32-char-min-random-secret

# ---------------------------------------------------------------------------
# MSW_ENABLED — opcional (default: desligado)
# ---------------------------------------------------------------------------
# Com "true", instrumentation.ts sobe o MSW server-side: os Route Handlers
# /api/** reais rodam, mas o fetch para a API NestJS é interceptado pelos
# handlers de mocks/. Usado pelos testes E2E (Playwright) para rodar sem
# backend. Deixe desligado no desenvolvimento normal contra a API real.
# MSW_ENABLED=true
